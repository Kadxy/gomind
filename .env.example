# docker-compose settings — copy to .env and edit.

# Where the app listens on the host, for your reverse proxy to target.
# Loopback-only by default; use 0.0.0.0:8000 to expose directly.
BIND=127.0.0.1:8000

# Comma-separated Origin allowlist for WebSocket upgrades; '*' = any.
ALLOWED_ORIGINS=*

# Only used by docker-compose.caddy.yml: hostname Caddy serves and gets a
# certificate for. `:80` = plain HTTP (e.g. behind a CDN).
DOMAIN=gomind.example.com
